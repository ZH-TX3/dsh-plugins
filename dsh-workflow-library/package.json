{
  "name": "@local/dsh-workflow-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discover .workflow.js assets and expose them as /wf:<name> commands and a workflow_library tool",
  "exports": {
    ".": "./index.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}
